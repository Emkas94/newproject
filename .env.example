# Environment variables for TurboScribe

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/turboscribe

# Redis
REDIS_URL=redis://localhost:6379/0

# S3/MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=turboscribe-media
S3_REGION=us-east-1

# Storage directories (local development)
UPLOAD_DIR=uploads
ARTIFACTS_DIR=artifacts

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
API_KEY_SALT=change-me-in-production

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Application
DEBUG=True
LOG_LEVEL=INFO

# GPU settings
CUDA_VISIBLE_DEVICES=0
